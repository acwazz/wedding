# ponytail: fixed passphrase — state holds no secrets; rotate if secrets ever added
export PULUMI_CONFIG_PASSPHRASE := "local"

# static validation (lock freshness + entry syntax) — no pulumi login needed
check:
    uv lock --check
    uv run python -m py_compile __main__.py

login:
    pulumi login file://$PWD

up: login
    pulumi up --stack dev

preview: login
    pulumi preview --stack dev

destroy: login
    pulumi destroy --stack dev
